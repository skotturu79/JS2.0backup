# Copy to ".env" (same folder) and fill in. REST Client reads it via {{$dotenv VAR}}.
# .env should be git-ignored — never commit real credentials.

HOST=10.254.2.59:44300
SAP_CLIENT=200

# Base64 of "user:password" for Basic auth. Generate WITHOUT echoing to a shared log:
#   VS Code terminal:  node -e "process.stdout.write(Buffer.from('USER:PASS').toString('base64'))"
#   or:                echo -n 'USER:PASS' | base64
BASIC_AUTH_B64=

# An inbound delivery number to test against (from request #2 in the .http)
IBD_NUMBER=
